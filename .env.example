# Day 6 Postgres + pgvector (container day6_student_starter, local only)
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab
DAY6_STRATEGY=B

# Query embeddings: must be the same model/dimensions as the Day 6 index
OPENROUTER_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-small

# Agent model
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-haiku-5-5

# Translation for the review tool (RouteAPI, OpenAI-compatible; key starts with sk-)
ROUTEAPI_API_KEY=
TRANSLATE_MODEL=deepseek-v4.1-flash
